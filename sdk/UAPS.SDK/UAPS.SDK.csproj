<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>UAPS.SDK</RootNamespace>
    <AssemblyName>UAPS.SDK</AssemblyName>
    <Description>U-APS Scheduling SDK</Description>
    <PackageId>UAPS.SDK</PackageId>
    <IsPackable>true</IsPackable>
    <!-- Trim- and AOT-safe: the wire format is source-generated JSON and the engine
         is reached through P/Invoke. A trim or AOT warning here fails the build. -->
    <IsAotCompatible>true</IsAotCompatible>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL3050;IL3051</WarningsAsErrors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Scoped to this package rather than the repository README: nuget.org
       renders the readme on the package page and does not resolve relative
       links, so a whole-repository document loses its links and buries what a
       consumer of this one package needs. -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Native engine binaries, staged per-RID under runtimes/ before `dotnet pack`
       (release.yml's build-dotnet job; empty/absent locally). NuGet recognizes this
       layout and copies the matching RID's asset to a consuming app's output during
       its own build/publish, so referencing this package is enough on its own —
       no separate download step required. -->
  <ItemGroup>
    <None Include="runtimes/**" Pack="true" PackagePath="runtimes/" Condition="Exists('runtimes')" />
  </ItemGroup>

  <ItemGroup>
    <!-- CloneRequest is the seam a what-if scenario is built on, and it is not
         part of the public API. Opening it to the test assembly is what lets a
         regression cover it without widening the surface consumers see. -->
    <InternalsVisibleTo Include="UAPS.SDK.Tests" />
  </ItemGroup>

</Project>
