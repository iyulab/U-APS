<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Dependencies -->
    <!-- System.Text.Json is included in .NET 10 runtime -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />

    <!-- Workbench Dependencies (WPF + Blazor Hybrid) -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.0-rc.1.25452.6" />
    <PackageVersion Include="Radzen.Blazor" Version="5.5.4" />
    <!-- Pin transitive dependency to fix GHSA-4cv2-4hjh-77rx vulnerability -->
    <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.6.1" />

    <!-- Test Dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- AwesomeAssertions is the community fork of FluentAssertions 7, kept under
         the Apache 2.0 licence that FluentAssertions 8 left behind for a paid
         proprietary one. Namespace and package are renamed as of its v9. -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
  </ItemGroup>
</Project>
